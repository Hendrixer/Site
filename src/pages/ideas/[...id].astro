---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getIdeas } from '../../lib/posts';

export async function getStaticPaths() {
  const ideas = await getIdeas();
  return ideas.map((idea) => ({ params: { id: idea.id }, props: { idea } }));
}

const { idea } = Astro.props;
const { Content } = await render(idea);
---

<Post
  kind="Idea"
  title={idea.data.title}
  date={idea.data.date}
  summary={idea.data.summary}
  draft={idea.data.draft}
  back={{ href: '/#ideas', label: 'More ideas' }}
>
  <Content />
</Post>
