---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import { profile, rich, visibleSections } from '../lib/content';
import { compact, getStars, monthYear } from '../lib/format';
import { hostOf, previewFor } from '../lib/og';

// Build-time enrichment:
// - open source: star counts from GitHub when `repo` is set
// - apps: a preview image from the app's own site (its og:image) unless `image` is set
const sections = await Promise.all(
  visibleSections.map(async (section) => {
    if (section.type === 'oss') {
      return {
        ...section,
        items: await Promise.all(
          section.items.map(async (item) => ({
            ...item,
            stars: item.repo ? await getStars(item.repo, item.stars ?? 0) : item.stars,
          })),
        ),
      };
    }
    if (section.type === 'apps') {
      return {
        ...section,
        items: await Promise.all(
          section.items.map(async (app) => ({ ...app, preview: await previewFor(app.image, app.url) })),
        ),
      };
    }
    return section;
  }),
);

const seen = new Map<string, number>();
const anchor = (type: string) => {
  const n = (seen.get(type) ?? 0) + 1;
  seen.set(type, n);
  return n === 1 ? type : `${type}-${n}`;
};

const hasPortrait = existsSync(join(process.cwd(), 'public', profile.portrait));
const footerLinks = [
  ['YouTube', profile.links.youtube],
  ['GitHub', profile.links.github],
  ['X', profile.links.x],
].filter(([, url]) => url);
const meta = (...parts: (string | undefined | false)[]) => parts.filter(Boolean).join(' · ');
const external = (url: string) => (/^https?:\/\//.test(url) ? { target: '_blank', rel: 'noopener' } : {});
---

<Base>
  <main>
    <header class="me in" style="--i:0">
      <div class="avatar">
        {hasPortrait ? <img src={profile.portrait} alt={profile.name} width="46" height="46" /> : <span aria-hidden="true">{profile.initials}</span>}
      </div>
      <div>
        <h1>{profile.name}</h1>
        {profile.tagline && <p>{profile.tagline}</p>}
      </div>
    </header>

    {profile.intro.length > 0 && (
      <div class="intro in" style="--i:1">
        {profile.intro.map((paragraph) => <p set:html={rich(paragraph)} />)}
      </div>
    )}
    {profile.cta && (
      <div class="cta top in" style="--i:2">
        <a class="mail" href={`mailto:${profile.cta.email}${profile.cta.subject ? `?subject=${encodeURIComponent(profile.cta.subject)}` : ''}`}>{profile.cta.label}<span aria-hidden="true">→</span></a>
        <button class="copy addr" type="button" data-email={profile.cta.email}>{profile.cta.email}<span>copy</span></button>
      </div>
    )}
    {profile.now && <div class="now in" style="--i:2"><span class="pulse" aria-hidden="true"></span><b>Now</b>{profile.now}</div>}

    {sections.map((section, i) => {
      const id = anchor(section.type);
      const style = `--i:${i + 3}`;
      const headLink = 'link' in section && section.link?.url ? section.link : null;
      const heading = (
        <h2>{section.title}{headLink && <a href={headLink.url} {...external(headLink.url)}>{headLink.label} ↗</a>}</h2>
      );

      if (section.type === 'research') return (
        <section id={id} class="in" style={style}>
          {heading}
          <ol class="rows dated">
            {section.items.map((item) => (
              <li>
                <a class="row" href={item.url} {...external(item.url)}>
                  <span class="t">{item.title}</span>
                  <span class="arr" aria-hidden="true">{/^https?:/.test(item.url) ? '↗' : '→'}</span>
                  <span class="m">{item.date ? monthYear(item.date) : ''}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      );

      if (section.type === 'experiments') return (
        <section id={id} class="in" style={style}>
          {heading}
          <ol class="exps">
            {section.items.map((exp) => (
              <li class="exp">
                <div class="xm">
                  <span>{exp.area}</span>
                  <span class="xs"><span class="pulse" aria-hidden="true"></span>{exp.status}</span>
                </div>
                <h3 class="xt">
                  {exp.url ? <a class="ul" href={exp.url} {...external(exp.url)}>{exp.title} <span aria-hidden="true">{/^https?:/.test(exp.url) ? '↗' : '→'}</span></a> : exp.title}
                </h3>
                <p class="xp" set:html={rich(exp.premise)} />
              </li>
            ))}
          </ol>
        </section>
      );

      if (section.type === 'work') {
        const mailto = `mailto:${section.email}?subject=${encodeURIComponent('Working together')}`;
        return (
          <section id={id} class="in" style={style}>
            {heading}
            {section.lead && <p class="pitch" set:html={rich(section.lead)} />}
            {section.body && <p class="lead" set:html={rich(section.body)} />}
            {section.items.length > 0 && <ol class="offers">
              {section.items.map((offer, n) => (
                <li class="offer">
                  <span class="n">{String(n + 1).padStart(2, '0')}</span>
                  <div>
                    <div class="ot">{offer.title}{offer.tag && <span class="tag">{offer.tag}</span>}</div>
                    <p>{offer.description}</p>
                  </div>
                </li>
              ))}
            </ol>}
            <div class="cta">
              <a class="mail" href={mailto}>{section.cta}<span aria-hidden="true">→</span></a>
              <button class="copy addr" type="button" data-email={section.email}>{section.email}<span>copy</span></button>
            </div>
          </section>
        );
      }

      if (section.type === 'courses') return (
        <section id={id} class="in" style={style}>
          {heading}
          <ol class="rows courses">
            {section.items.map((course) => (
              <li>
                <a class="row" href={course.url} {...external(course.url)}>
                  {course.image ? <img class="cimg" src={course.image} alt="" width="44" height="44" loading="lazy" /> : <span class="cimg" aria-hidden="true"></span>}
                  <span class="ctext">
                    <span class="t">{course.title}</span>
                    {course.description && <span class="d">{course.description}</span>}
                  </span>
                  <span class="m">{meta(course.duration, course.date && monthYear(course.date))}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      );

      if (section.type === 'apps') return (
        <section id={id} class="in" style={style}>
          {heading}
          <div class="cards apps">
            {section.items.map((app) => (
              <a class="card app" href={app.url} style={`--tint:${app.tint}`} {...external(app.url)}>
                {app.preview ? (
                  <div class="shot">
                    <img src={app.preview.src} srcset={app.preview.srcset} sizes="(max-width: 560px) 100vw, 640px" alt={`${app.name} preview`} loading="lazy" decoding="async" />
                  </div>
                ) : (
                  <div class="tile">
                    {app.icon && <span class="icon"><img src={app.icon} alt="" width="68" height="68" loading="lazy" /></span>}
                  </div>
                )}
                <div class="arow">
                  {app.preview && app.icon && <span class="icon sm"><img src={app.icon} alt="" width="32" height="32" loading="lazy" /></span>}
                  <span class="atext">
                    <span class="an">{app.name}{app.platform && <span class="tag">{app.platform}</span>}</span>
                    {hostOf(app.url) && <span class="dom">{hostOf(app.url)} ↗</span>}
                  </span>
                </div>
                <span class="cm ad">{meta(app.description, app.year !== undefined && String(app.year))}</span>
              </a>
            ))}
          </div>
        </section>
      );

      if (section.type === 'oss') return (
        <section id={id} class="in" style={style}>
          {heading}
          <ol class="rows">
            {section.items.map((item, n) => (
              <li>
                <a class="row" href={item.url} data-pv={item.snippet ? `${id}-${n}` : undefined} {...external(item.url)}>
                  <span class="t">{item.name}</span>
                  <span class="d">{item.description}</span>
                  <span class="m">
                    {item.stars !== undefined && (
                      <>
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 .8l2.2 4.6 5 .7-3.6 3.5.9 5L8 12.2 3.5 14.6l.9-5L.8 6.1l5-.7z" /></svg>
                        {compact(item.stars)}
                      </>
                    )}
                  </span>
                </a>
                {item.snippet && <template id={`pv-${id}-${n}`}><pre class="code">{item.snippet}</pre></template>}
              </li>
            ))}
          </ol>
        </section>
      );

      if (section.type === 'videos') return (
        <section id={id} class="in" style={style}>
          {heading}
          <div class="cards videos">
            {section.items.map((video) => (
              <a class="card" href={video.url} {...external(video.url)}>
                <div class="thumb">
                  {video.youtubeId ? (
                    <img src={`https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`} alt="" loading="lazy" />
                  ) : (
                    <div class="th" style={`background:${video.thumb?.bg ?? '#18181a'};color:${video.thumb?.fg ?? '#fff'}`}>
                      <b>{video.thumb?.text ?? video.title}</b>
                    </div>
                  )}
                  {video.duration && <em>{video.duration}</em>}
                </div>
                <div class="ct">{video.title}</div>
                <div class="cm">{meta(video.views && `${video.views} views`, video.date && monthYear(video.date))}</div>
              </a>
            ))}
          </div>
        </section>
      );
    })}

    <footer class="in" style={`--i:${sections.length + 3}`}>
      <div class="links">
        {footerLinks.map(([label, url]) => <a href={url} target="_blank" rel="noopener">{label}</a>)}
        <button class="copy" type="button" data-email={profile.email}>Email <span>copy</span></button>
      </div>
    </footer>
  </main>

  <div class="pv" id="pv" aria-hidden="true"><div class="pv-in" id="pv-in"></div></div>
</Base>

<script>
  const pv = document.getElementById('pv');
  const pvIn = document.getElementById('pv-in');
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (pv && pvIn && fine) {
    let tx = 0, ty = 0, x = 0, y = 0, vx = 0, on = false, raf = 0, key = '';

    const loop = () => {
      const nx = x + (tx - x) * (reduce ? 1 : 0.18);
      const ny = y + (ty - y) * (reduce ? 1 : 0.18);
      vx = vx * 0.8 + (nx - x) * 0.2;
      x = nx;
      y = ny;
      const rot = reduce ? 0 : Math.max(-6, Math.min(6, vx * 0.45));
      pv.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0) rotate(${rot.toFixed(2)}deg)`;
      raf = on || Math.abs(tx - x) > 0.5 ? requestAnimationFrame(loop) : 0;
    };
    const place = (e: PointerEvent) => {
      tx = Math.min(innerWidth - 316, e.clientX + 28);
      ty = Math.max(16, Math.min(innerHeight - 212, e.clientY - 98));
    };

    document.querySelectorAll<HTMLElement>('[data-pv]').forEach((row) => {
      row.addEventListener('pointerenter', (e) => {
        const k = row.dataset.pv ?? '';
        const tpl = document.getElementById(`pv-${k}`) as HTMLTemplateElement | null;
        if (!tpl) return;
        if (k !== key) {
          pvIn.replaceChildren(tpl.content.cloneNode(true));
          key = k;
        }
        place(e);
        if (!on) {
          x = tx;
          y = ty + 10;
        }
        on = true;
        pv.classList.add('on');
        if (!raf) raf = requestAnimationFrame(loop);
      });
      row.addEventListener('pointermove', place);
      row.addEventListener('pointerleave', () => {
        on = false;
        pv.classList.remove('on');
      });
    });
  }
</script>

<style>
  .me {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 36px;
  }
  .avatar {
    position: relative;
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--hover);
    display: grid;
    place-items: center;
    font: 500 12.5px/1 var(--mono);
    color: var(--muted);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  h1 {
    font-size: 15px;
    font-weight: 500;
    margin: 0;
    line-height: 1.35;
  }
  .me p {
    margin: 0;
    color: var(--muted);
    line-height: 1.35;
  }
  .intro {
    font-size: 16px;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .intro p {
    margin: 0 0 14px;
  }
  .intro p:first-child {
    font-size: 18px;
    line-height: 1.55;
    font-weight: 500;
    letter-spacing: -0.012em;
  }
  .intro p + p {
    color: var(--muted);
  }
  .cta.top {
    margin: 22px 0 20px;
  }
  .now {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    color: var(--muted);
    padding: 6px 12px 6px 10px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .now b {
    font-weight: 500;
    color: var(--text);
  }
  .pulse {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1.5px solid var(--green);
    opacity: 0;
    animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    0% { transform: scale(0.4); opacity: 0.7; }
    80%, 100% { transform: scale(1.3); opacity: 0; }
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 12px;
    padding: 9px 10px;
    margin: 0 -10px;
    border-radius: 8px;
    transition: background-color 0.18s;
  }
  .row .t {
    font-weight: 500;
    white-space: nowrap;
  }
  .row .d {
    color: var(--muted);
  }
  .row .m {
    font: 12.5px/1 var(--mono);
    color: var(--faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition: color 0.18s;
  }
  .row .m svg {
    width: 11px;
    height: 11px;
    vertical-align: -1px;
    margin-right: 4px;
  }
  .row:hover {
    background: var(--hover);
  }
  .row:hover .m {
    color: var(--muted);
  }
  .dated .row {
    grid-template-columns: 76px minmax(0, 1fr) auto;
  }
  .dated .t {
    white-space: normal;
  }
  .dated .m {
    order: -1;
  }
  .dated .arr {
    color: var(--faint);
    opacity: 0;
    transform: translateX(-3px);
    transition: opacity 0.2s, transform 0.3s var(--ease);
  }
  .dated .row:hover .arr {
    opacity: 1;
    transform: none;
  }

  .courses .row {
    grid-template-columns: 44px minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 14px;
    padding: 8px 10px;
  }
  .cimg {
    display: block;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    object-fit: cover;
    background: var(--hover);
    outline: 1px solid var(--line);
    outline-offset: -1px;
    transition: transform 0.45s var(--ease);
  }
  .courses .row:hover .cimg {
    transform: scale(1.06) rotate(-2deg);
  }
  .ctext {
    display: grid;
    gap: 1px;
    min-width: 0;
  }
  .courses .t {
    white-space: normal;
    line-height: 1.4;
  }
  .courses .d {
    font-size: 13.5px;
    line-height: 1.45;
  }

  .exps {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .exp {
    padding: 18px 0 20px;
    border-bottom: 1px solid var(--line);
  }
  .xm {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font: 12px/1.3 var(--mono);
    color: var(--faint);
  }
  .xs {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
    white-space: nowrap;
  }
  .xs .pulse {
    width: 6px;
    height: 6px;
  }
  .xt {
    margin: 8px 0 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .xt a span {
    color: var(--faint);
  }
  .xp {
    margin: 6px 0 0;
    color: var(--muted);
    text-wrap: pretty;
  }

  .pitch {
    margin: 0 0 12px;
    font-size: 19px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .lead {
    margin: 0 0 18px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .offers {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .offer {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .offer .n {
    font: 12.5px/1.75 var(--mono);
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .ot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    font-weight: 500;
  }
  .tag {
    font: 500 11px/1 var(--mono);
    color: var(--muted);
    padding: 4px 7px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .offer p {
    margin: 4px 0 0;
    color: var(--muted);
    text-wrap: pretty;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 20px;
  }
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-weight: 500;
    font-size: 14px;
    transition: opacity 0.2s, transform 0.4s var(--ease);
  }
  .mail span {
    transition: transform 0.4s var(--ease);
  }
  .mail:hover span {
    transform: translateX(3px);
  }
  .mail:active {
    transform: scale(0.97);
  }
  .addr {
    display: inline-flex;
    gap: 6px;
    align-items: baseline;
    font: 13px var(--mono);
    color: var(--muted);
    transition: color 0.2s;
  }
  .addr:hover {
    color: var(--text);
  }
  .addr span {
    color: var(--faint);
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 16px;
    margin-top: 6px;
  }
  .card {
    display: block;
  }
  .tile,
  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.45s var(--ease);
  }
  .card:hover .tile,
  .card:hover .thumb {
    transform: scale(0.982);
  }
  .tile {
    display: grid;
    place-items: center;
    background: color-mix(in oklab, var(--tint) 12%, var(--bg));
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--tint) 12%, var(--line));
  }
  .icon {
    width: 68px;
    height: 68px;
    border-radius: 22.5%;
    overflow: hidden;
    box-shadow: 0 12px 24px -12px color-mix(in oklab, var(--tint) 80%, #000), inset 0 0 0 1px rgba(0, 0, 0, 0.08);
    transition: transform 0.6s var(--ease), box-shadow 0.6s var(--ease);
  }
  .icon {
    outline: 1px solid color-mix(in oklab, var(--text) 12%, transparent);
    outline-offset: -1px;
  }
  .icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card:hover .icon {
    transform: translateY(-4px) scale(1.05);
    box-shadow: 0 20px 32px -14px color-mix(in oklab, var(--tint) 80%, #000), inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
  .cards.apps > .card:first-child:nth-last-child(odd) {
    grid-column: 1 / -1;
  }
  .shot {
    position: relative;
    aspect-ratio: 1200 / 630;
    border-radius: 12px;
    overflow: hidden;
    background: color-mix(in oklab, var(--tint) 12%, var(--bg));
    box-shadow: 0 0 0 1px var(--line);
  }
  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .card:hover .shot img {
    transform: scale(1.025);
  }
  .arow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }
  .icon.sm {
    width: 32px;
    height: 32px;
    box-shadow: 0 6px 14px -8px color-mix(in oklab, var(--tint) 80%, #000);
  }
  .card:hover .icon.sm {
    transform: none;
  }
  .atext {
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  .an {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    font-weight: 500;
    line-height: 1.35;
  }
  .ad {
    display: block;
    margin-top: 10px;
    max-width: 52ch;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .dom {
    font: 12px/1.2 var(--mono);
    color: var(--faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s;
  }
  .card:hover .dom {
