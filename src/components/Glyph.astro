---
// Small line icons for ideas and research on the homepage.
// Pick one by name with an `icon` field ("harness", "goal", "agents", "memory"),
// or point `icon` at an image in public/. Anything else gets the default mark.
// Strokes follow the text color; the accent is green (or warm for a warning).
interface Props {
  name?: string;
}
const { name } = Astro.props;
const known = ['harness', 'goal', 'agents', 'memory'];
const glyph = name && known.includes(name) ? name : 'default';
const image = name?.startsWith('/') ? name : undefined;
---

<span class="tile" aria-hidden="true">
  {image ? (
    <img src={image} alt="" width="22" height="22" />
  ) : (
    <svg viewBox="0 0 24 24" class={`g g-${glyph}`}>
      {glyph === 'harness' && (
        <>
          {/* An app window with its operations, wired to an agent. */}
          <rect x="2.75" y="4.75" width="12.5" height="14.5" rx="2.5" />
          <path d="M2.75 8.5h12.5" />
          <path d="M5.75 12h6" />
          <path d="M5.75 15.5h3.5" />
          <path class="wire" d="M15.25 12h2.5" />
          <circle class="accent fill agent" cx="19.75" cy="12" r="1.9" />
        </>
      )}
      {glyph === 'goal' && (
        <>
          {/* A goal held in a loop: the ring, the target, and progress around it. */}
          <circle cx="12" cy="12" r="8.25" />
          <circle class="fill" cx="12" cy="12" r="1.6" />
          <g class="orbit">
            <path class="accent" d="M12 3.75a8.25 8.25 0 0 1 7.14 12.38" />
            <circle class="accent fill" cx="19.14" cy="16.13" r="1.65" />
          </g>
        </>
      )}
      {glyph === 'agents' && (
        <>
          {/* Agents that each do their part, with one handoff that never lands. */}
          <path d="M4.5 12 12 4.5 19.5 12" />
          <path d="M4.5 12 12 19.5" />
          <path class="broken" d="M19.5 12 12 19.5" />
          <circle class="dot" cx="12" cy="4.5" r="2.1" />
          <circle class="dot" cx="4.5" cy="12" r="2.1" />
          <circle class="dot" cx="19.5" cy="12" r="2.1" />
          <circle class="warn fill" cx="12" cy="19.5" r="2.1" />
        </>
      )}
      {glyph === 'memory' && (
        <>
          {/* Events across sessions, with memory linking the first to the last. */}
          <path d="M2.5 16h19" />
          <path class="accent arc" d="M4.5 16Q12 0.5 19.5 16" pathLength="1" />
          <circle class="accent fill" cx="4.5" cy="16" r="1.9" />
          <circle class="dot" cx="9.5" cy="16" r="1.5" />
          <circle class="dot" cx="14.5" cy="16" r="1.5" />
          <circle class="accent fill" cx="19.5" cy="16" r="1.9" />
        </>
      )}
      {glyph === 'default' && (
        <>
          <circle cx="12" cy="12" r="7.5" />
          <circle class="accent fill" cx="12" cy="12" r="2" />
        </>
      )}
    </svg>
  )}
</span>

<style>
  .tile {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 11px;
    background: color-mix(in oklab, var(--hover) 70%, transparent);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--muted);
    transition: color 0.25s, box-shadow 0.25s;
  }
  .tile img {
    width: 22px;
    height: 22px;
  }
  .g {
    width: 22px;
    height: 22px;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Hollow nodes are filled with the tile color so lines don't show through. */
  .g .dot {
    fill: color-mix(in oklab, var(--hover) 70%, var(--bg));
  }
  .g .fill {
    fill: currentColor;
    stroke: none;
  }
  .g .accent {
    stroke: var(--green);
  }
  .g .accent.fill {
    fill: var(--green);
    stroke: none;
  }
  .g .warn.fill {
    fill: var(--warn);
  }
  .g .broken {
    stroke-dasharray: 2 2.6;
    opacity: 0.7;
  }

  /* A small motion when the row it belongs to is hovered. */
  .orbit {
    transform-origin: 12px 12px;
    transition: transform 0.8s var(--ease);
  }
  .agent,
  .wire {
    transition: transform 0.5s var(--ease);
  }
  .arc {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  :global(:is(.row, .exp):hover) .tile {
    color: var(--text);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--text) 30%, var(--line));
  }
  :global(:is(.row, .exp):hover) .orbit {
    transform: rotate(120deg);
  }
  :global(:is(.row, .exp):hover) .agent {
    transform: translateX(-1.25px);
  }
  :global(:is(.row, .exp):hover) .broken {
    animation: march 0.9s linear infinite;
  }
  :global(:is(.row, .exp):hover) .arc {
    animation: draw 0.9s var(--ease);
  }
  @keyframes march {
    to {
      stroke-dashoffset: -4.6;
    }
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit,
    .agent,
    .wire {
      transition: none;
    }
    :global(:is(.row, .exp):hover) .broken,
    :global(:is(.row, .exp):hover) .arc {
      animation: none;
    }
  }
</style>
