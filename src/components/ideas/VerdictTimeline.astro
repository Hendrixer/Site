---
// Idea: a goal runtime.
// One day of a maintain goal: the measurement, the target and the verdict.
// The data is illustrative and generated here, so the shape is easy to edit.
import Figure from './Figure.astro';

const TARGET = 300; // ms
const W = 1000;
const H = 260;
const y = (ms: number) => H - 10 - (ms / 600) * (H - 20);
const smooth = (t: number) => t * t * (3 - 2 * t);

// The story: latency drifts up after a deploy at 09:20, the rollback lands at
// 10:45 and the goal is verified again by 11:15. Monitoring goes quiet 15:40–17:00.
const PEAK = 412; // matches the loop figure
const ROLLBACK = 10.75;
const base = (t: number) =>
  226 + 12 * Math.sin(t * 0.9) + 7 * Math.sin(t * 2.7 + 1) + 34 * Math.exp(-((t - 13) ** 2) / 6);
const shape = (t: number) => {
  if (t >= 9.33 && t < 9.9) return smooth((t - 9.33) / 0.57);
  if (t >= 9.9 && t < ROLLBACK) return 1;
  if (t >= ROLLBACK && t < 11.25) return 1 - smooth((t - ROLLBACK) / 0.5);
  return 0;
};
const hours = Array.from({ length: 24 * 12 + 1 }, (_, i) => i / 12);
const plateauBase = Math.max(...hours.filter((t) => shape(t) === 1).map(base));
const lift = PEAK - plateauBase;

// p95 latency (ms) at hour t, or null while monitoring is silent.
const p95 = (t: number): number | null => (t > 15.66 && t < 17.0 ? null : base(t) + lift * shape(t));

const samples = hours.map((t) => ({ t, v: p95(t) }));

let d = '';
let pen = false;
for (const { t, v } of samples) {
  if (v === null) {
    pen = false;
    continue;
  }
  d += `${pen ? 'L' : 'M'}${((t / 24) * W).toFixed(1)} ${y(v).toFixed(1)}`;
  pen = true;
}

// Run-length the verdict for each sample into strip segments (percent of the day).
type Kind = 'satisfied' | 'violated' | 'unknown';
const kindAt = (v: number | null): Kind => (v === null ? 'unknown' : v >= TARGET ? 'violated' : 'satisfied');
const segments: { kind: Kind; start: number; width: number }[] = [];
for (let i = 0; i < samples.length - 1; i++) {
  const kind = kindAt(samples[i].v);
  const start = (samples[i].t / 24) * 100;
  const width = (1 / 12 / 24) * 100;
  const prev = segments[segments.length - 1];
  if (prev && prev.kind === kind) prev.width += width;
  else segments.push({ kind, start, width });
}

const peak = samples.reduce((a, b) => ((b.v ?? 0) > (a.v ?? 0) ? b : a));
const gap = segments.find((s) => s.kind === 'unknown')!;
---

<Figure
  n={3}
  caption="A made-up day for the checkout goal. It slips, gets rolled back and only counts as fixed once monitoring confirms it. When monitoring goes quiet for an hour, the honest answer is unknown."
>
  <div class="tl" data-play="1" data-interval="200" data-hold="7600">
    <div class="plot reveal" data-at="1">
      <span class="band" style={`left:${gap.start}%;width:${gap.width}%`} aria-hidden="true"></span>
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <clipPath id="verdict-above-target">
            <rect x="0" y="0" width={W} height={y(TARGET)} />
          </clipPath>
        </defs>
        <line class="target" x1="0" x2={W} y1={y(TARGET)} y2={y(TARGET)} />
        <path class="line" d={d} />
        <path class="line hot" d={d} clip-path="url(#verdict-above-target)" />
      </svg>
      <span class="tlabel" style={`top:${(y(TARGET) / H) * 100}%`}>target 300 ms</span>
      <span class="ann" style={`left:${(peak.t / 24) * 100}%`}>p95 {Math.round(peak.v ?? 0)} ms · reopened</span>
      <span class="ann low" style={`left:${(ROLLBACK / 24) * 100}%`}>↑ rollback</span>
      <span class="ann low gap" style={`left:${gap.start + gap.width / 2}%`}>no data</span>
    </div>
    <div class="axis" aria-hidden="true">
      <span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>24:00</span>
    </div>
    <div class="strip reveal" data-at="1">
      {segments.map((s) => (
        <span class:list={['seg', s.kind]} style={`left:${s.start}%;width:${s.width}%`}></span>
      ))}
    </div>
    <div class="legend">
      <span><i class="satisfied"></i>satisfied</span>
      <span><i class="violated"></i>violated</span>
      <span><i class="unknown"></i>unknown</span>
    </div>
  </div>
</Figure>

<style>
  .tl {
    font: 11.5px/1.3 var(--mono);
    color: var(--faint);
  }
  .plot {
    position: relative;
    height: 190px;
    margin-top: 18px;
  }
  .plot svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .target {
    stroke: var(--faint);
    stroke-width: 1;
    stroke-dasharray: 4 4;
    vector-effect: non-scaling-stroke;
  }
  .line {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .line.hot {
    stroke: var(--warn);
    stroke-width: 2;
  }
  .band {
    position: absolute;
    top: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in oklab, var(--faint) 30%, transparent) 0 1px,
      transparent 1px 6px
    );
  }
  .tlabel {
    position: absolute;
    right: 0;
    transform: translateY(-140%);
    color: var(--muted);
  }
  .ann {
    position: absolute;
    top: -18px;
    transform: translateX(-50%);
    white-space: nowrap;
    color: var(--warn);
  }
  .ann.low {
    top: auto;
    bottom: 4px;
    color: var(--muted);
  }
  .ann.gap {
    background: var(--bg);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .axis {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
  }
  .strip {
    position: relative;
    height: 10px;
    margin-top: 12px;
    border-radius: 999px;
    overflow: hidden;
    background: var(--line);
  }
  .seg {
    position: absolute;
    top: 0;
    bottom: 0;
  }
  .satisfied {
    background: var(--green);
  }
  .violated {
    background: var(--warn);
  }
  .unknown {
    background: repeating-linear-gradient(-45deg, var(--faint) 0 1.5px, transparent 1.5px 4px);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 12px;
    color: var(--muted);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .legend i {
    width: 14px;
    height: 8px;
    border-radius: 999px;
  }

  /* Sweep through the day from left to right. */
  .tl:global(.playing) .reveal {
    clip-path: inset(-30px 100% -30px 0);
    transition: clip-path 3.4s linear;
  }
  .tl:global(.playing) .reveal:global(.on) {
    clip-path: inset(-30px 0 -30px 0);
  }
  @media (max-width: 560px) {
    .plot {
      height: 150px;
    }
    .axis span:nth-child(even) {
      visibility: hidden;
    }
  }
</style>
