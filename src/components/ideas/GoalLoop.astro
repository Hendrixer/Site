---
// Idea: a goal runtime.
// The loop a maintain goal runs, with the goal's verdict in the middle.
import Figure from './Figure.astro';

const stages = ['Observe', 'Evaluate', 'Explore', 'Verify', 'Approve', 'Act'];
const radius = 38; // percent of the square
const nodes = stages.map((name, i) => {
  const angle = ((-90 + i * 60) * Math.PI) / 180;
  return {
    name,
    left: 50 + radius * Math.cos(angle),
    top: 50 + radius * Math.sin(angle),
    // Observe is lit at the start of the loop and again when it comes back around.
    show: i === 0 ? '1 7' : String(i + 1),
  };
});

type Verdict = 'unknown' | 'violated' | 'satisfied';
const states: { verdict: Verdict; note: string }[] = [
  { verdict: 'unknown', note: 'reading p95 from monitoring' },
  { verdict: 'violated', note: 'p95 412 ms, target 300 ms' },
  { verdict: 'violated', note: 'four candidate plans' },
  { verdict: 'violated', note: 'rollback passes every invariant' },
  { verdict: 'violated', note: 'on-call approves the rollback' },
  { verdict: 'violated', note: 'rolling back v218' },
  { verdict: 'satisfied', note: 'p95 238 ms, independently checked' },
];
const last = states.length;
---

<Figure
  n={1}
  caption="Roughly the loop for an ongoing goal: notice something, compare it to the goal, explore options, check them, get a yes, act, then look again to see if it worked."
>
  <div class="loop" data-play={last} data-loop-from="1" data-interval="1500" data-hold="2600">
    <svg class="ring" viewBox="0 0 100 100" aria-hidden="true">
      <circle cx="50" cy="50" r={radius} />
      <circle class="progress" cx="50" cy="50" r={radius} pathLength="100" transform="rotate(-90 50 50)" />
    </svg>
    <div class="orbit" aria-hidden="true"></div>
    {nodes.map((node) => (
      <span class="node" style={`left:${node.left}%;top:${node.top}%`} data-show={node.show}>
        {node.name}
      </span>
    ))}
    <div class="core">
      <span class="kind">ongoing goal</span>
      <span class="goal">checkout p95 &lt; 300 ms</span>
      <span class="verdicts">
        {states.map((s, i) => (
          <span class:list={['verdict', s.verdict, { cur: i === last - 1 }]} data-show={String(i + 1)}>
            {s.verdict}
          </span>
        ))}
      </span>
      <span class="notes">
        {states.map((s, i) => (
          <span class:list={['note', { cur: i === last - 1 }]} data-show={String(i + 1)}>{s.note}</span>
        ))}
      </span>
    </div>
  </div>
</Figure>

<style>
  .loop {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 1;
    margin: 0 auto;
  }
  .ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ring circle {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  /* How far around the loop this pass has come. */
  .ring .progress {
    stroke: var(--green);
    stroke-width: 0.5;
    stroke-linecap: round;
    vector-effect: none;
    stroke-dasharray: calc((var(--step, 7) - 1) * 16.6667) 100;
    transition: stroke-dasharray 1s var(--ease);
  }
  .orbit {
    position: absolute;
    inset: 0;
    transform: rotate(calc((var(--step, 7) - 1) * 60deg));
    transition: transform 1s var(--ease);
  }
  .orbit::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 12%;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 5px color-mix(in oklab, var(--green) 22%, transparent);
    transform: translate(-50%, -50%);
  }
  .node {
    position: absolute;
    transform: translate(-50%, -50%);
    padding: 6px 11px;
    border-radius: 999px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
    font: 12px/1 var(--mono);
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.3s, box-shadow 0.3s;
  }
  .node:global(.cur) {
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--text);
  }
  /* Observe sits on the ring at the top, so lift it above the orbiting dot. */
  .node {
    z-index: 1;
  }

  .core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 52%;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    gap: 6px;
    text-align: center;
  }
  .kind {
    font: 11px/1 var(--mono);
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .goal {
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .verdict {
    display: none;
    margin-top: 4px;
    padding: 4px 10px;
    border-radius: 999px;
    font: 500 12px/1 var(--mono);
  }
  .verdict:global(.cur) {
    display: inline-block;
  }
  .unknown {
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .violated {
    color: var(--warn);
    background: color-mix(in oklab, var(--warn) 12%, transparent);
  }
  .satisfied {
    color: var(--green);
    background: color-mix(in oklab, var(--green) 12%, transparent);
  }
  .note {
    display: none;
    font: 11.5px/1.45 var(--mono);
    color: var(--muted);
    text-wrap: balance;
  }
  .note:global(.cur) {
    display: block;
  }
  @media (max-width: 560px) {
    .node {
      padding: 5px 8px;
      font-size: 11px;
    }
    .goal {
      font-size: 13.5px;
    }
    .core {
      width: 58%;
    }
  }
</style>
