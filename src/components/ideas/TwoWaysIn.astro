---
// Idea: an agent harness built for apps.
// The same request through the app's screen (computer use) and through an
// interface the app built for agents. Step counts are illustrative.
import Figure from './Figure.astro';

const ui = [
  'screenshot',
  'find “Reports”',
  'click',
  'screenshot',
  'find “Q3”',
  'click',
  'screenshot',
  'find “Export”',
  'click',
  'wait',
  'screenshot',
  'read the result',
];
const api = ['read state', 'export_report(q3)', 'typed result'];
const last = ui.length;
---

<Figure
  n={1}
  caption="The same request two ways. Through the screen, the agent looks, finds, clicks and looks again for every step. Through an interface the app built for agents, it asks for the operation and gets a result back."
>
  <div class="ways" data-play={last} data-interval="520" data-hold="3400">
    <div class="ask">“Export the Q3 report”</div>

    <div class="way">
      <span class="wname">computer use</span>
      <span class="steps">
        {ui.map((s, i) => (
          <span class:list={['step', { look: s === 'screenshot' }]} data-at={i + 1}>{s}</span>
        ))}
      </span>
      <span class="count">
        <span data-show="0">0 steps</span>
        {ui.map((_, i) => (
          <span class:list={{ cur: i === last - 1 }} data-show={String(i + 1)}>{i + 1} {i === 0 ? 'step' : 'steps'}</span>
        ))}
      </span>
    </div>

    <div class="way">
      <span class="wname">built for agents</span>
      <span class="steps">
        {api.map((s, i) => (
          <span class:list={['step', 'op', { done: i === api.length - 1 }]} data-at={i + 1}>{s}</span>
        ))}
        <span class="fin" data-at={api.length}>✓ done</span>
      </span>
      <span class="count">
        <span data-show="0">0 calls</span>
        {Array.from({ length: last }, (_, i) => (
          <span class:list={{ cur: i === last - 1 }} data-show={String(i + 1)}>
            {Math.min(i + 1, api.length)} {i === 0 ? 'call' : 'calls'}
          </span>
        ))}
      </span>
    </div>
  </div>
</Figure>

<style>
  .ways {
    display: grid;
    gap: 16px;
    font: 11.5px/1 var(--mono);
    color: var(--muted);
  }
  .ask {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    font: 13.5px/1.4 var(--sans);
    color: var(--text);
  }
  .way {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 8px 14px;
  }
  .wname {
    grid-column: 1 / -1;
    color: var(--faint);
  }
  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    min-height: 26px;
  }
  .step {
    padding: 6px 8px;
    border-radius: 999px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
    white-space: nowrap;
    transition: opacity 0.3s, transform 0.35s var(--ease);
  }
  .step.look {
    color: var(--faint);
  }
  .step.op {
    border-radius: 6px;
    color: var(--text);
  }
  .step.done {
    color: var(--green);
    box-shadow: inset 0 0 0 1px var(--green);
  }
  .fin {
    align-self: center;
    margin-left: 4px;
    color: var(--green);
    transition: opacity 0.3s;
  }
  .count {
    padding-top: 6px;
    text-align: right;
    white-space: nowrap;
    color: var(--text);
  }
  .count span {
    display: none;
  }
  .count span:global(.cur) {
    display: inline;
  }

  .ways:global(.playing) .step,
  .ways:global(.playing) .fin {
    opacity: 0;
  }
  .ways:global(.playing) .step {
    transform: scale(0.92);
  }
  .ways:global(.playing) .step:global(.on),
  .ways:global(.playing) .fin:global(.on) {
    opacity: 1;
    transform: none;
  }
</style>
