---
// A page written in Markdown: an idea or a research write-up.
import Base from './Base.astro';
import { profile } from '../lib/content';
import { longDate } from '../lib/format';

interface Props {
  kind: string; // shown above the title, e.g. "Idea"
  title: string;
  date: Date;
  summary?: string;
  draft?: boolean;
  back: { href: string; label: string };
}

const { kind, title, date, summary, draft, back } = Astro.props;
const reply = `mailto:${profile.email}?subject=${encodeURIComponent(`Re: ${title}`)}`;
---

<Base title={title} description={summary}>
  <main>
    <nav class="back in" style="--i:0"><a href="/">← {profile.name}</a></nav>
    <header class="in" style="--i:1">
      <p class="eyebrow">
        {kind} · <time datetime={date.toISOString()}>{longDate(date)}</time>
        {draft && <span class="draft">Draft · not on the live site</span>}
      </p>
      <h1>{title}</h1>
      {summary && <p class="summary">{summary}</p>}
    </header>
    <article class="prose in" style="--i:2">
      <slot />
    </article>
    <footer class="in" style="--i:3">
      <a href={back.href}>{back.label}</a>
      <a href={reply}>Reply by email</a>
    </footer>
  </main>
</Base>

<style>
  .back {
    margin-bottom: 48px;
    font-size: 14px;
  }
  .back a {
    color: var(--muted);
    transition: color 0.2s;
  }
  .back a:hover {
    color: var(--text);
  }
  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    margin: 0;
    font: 12.5px/1.4 var(--mono);
    color: var(--faint);
  }
  .draft {
    padding: 3px 8px;
    border-radius: 999px;
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  h1 {
    margin: 10px 0 8px;
    font-size: clamp(26px, 5vw, 32px);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .summary {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    text-wrap: pretty;
  }
  .prose {
    margin-top: 40px;
    font-size: 16px;
    line-height: 1.75;
    text-wrap: pretty;
  }
  .prose :global(> :first-child) {
    margin-top: 0;
  }
  .prose :global(p) {
    margin: 0 0 1.1em;
  }
  .prose :global(h2) {
    display: block;
    margin: 2.2em 0 0.6em;
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .prose :global(h3) {
    margin: 1.8em 0 0.5em;
    font-size: 15px;
    font-weight: 600;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    text-decoration-color: var(--text);
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(em) {
    color: var(--muted);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.2em;
    margin: 0 0 1.1em;
  }
  .prose :global(li) {
    margin: 0.3em 0;
  }
  .prose :global(li::marker) {
    color: var(--faint);
  }
  .prose :global(blockquote) {
    margin: 1.4em 0;
    padding-left: 16px;
    border-left: 2px solid var(--line);
    color: var(--muted);
  }
  .prose :global(hr) {
    margin: 2.4em 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
  .prose :global(code) {
    font: 13.5px var(--mono);
    background: var(--hover);
    padding: 1px 5px;
    border-radius: 5px;
  }
  .prose :global(pre) {
    margin: 1.4em 0;
    padding: 16px 18px;
    border-radius: 10px;
    overflow-x: auto;
    font: 13px/1.7 var(--mono);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.4em 0;
    font-size: 14.5px;
    font-variant-numeric: tabular-nums;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(th) {
    font-weight: 500;
    color: var(--muted);
    font-size: 13px;
  }
  .prose :global(img) {
    max-width: 100%;
    border-radius: 10px;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  footer a {
    color: var(--muted);
    transition: color 0.2s;
  }
  footer a:hover {
    color: var(--text);
  }
</style>
